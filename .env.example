# FlavorOS .env — only NON-SECRET runtime config lives here.
# All secrets (API keys, tokens, OAuth) are in infra/secrets/secrets.enc.yaml
# and decrypted at boot by the secrets-loader. See SECRETS.md.

KHADIJAH_DOMAIN=flavor.example.com
POSTGRES_PASSWORD=change-me-strong         # also mirrored in secrets.enc.yaml; safe to set here for postgres init only
OBSIDIAN_GIT_REMOTE=git@github.com:you/flavor-vault.git

# Optional model overrides (read by openrouter-proxy if set)
# KHADIJAH_MODEL=anthropic/claude-sonnet-4.6
# WATSON_MODEL=openai/gpt-5-mini
